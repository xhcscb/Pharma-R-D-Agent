APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://pharma:pharma@postgres:5432/pharma
OBJECT_STORE_ROOT=/app/data/objects
PUBLIC_EXPORT_ROOT=/app/data/exports
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=2
WORKER_LOCK_SECONDS=900
INTERNAL_API_KEY=replace-with-a-long-random-secret
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=
SEC_DATA_BASE_URL=https://data.sec.gov
SEC_ARCHIVES_BASE_URL=https://www.sec.gov/Archives/edgar/data
# 必填后才允许同步 SEC。填写团队真实可联系邮箱，不要提交含密钥的 .env。
PROJECT_CONTACT_EMAIL=
SEC_USER_AGENT=
HTTP_USER_AGENT=pharma-analyst-data/0.2
HTTP_RATE_LIMIT_PER_SECOND=1
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
MILVUS_URI=http://milvus:19530
TIMESCALE_URL=postgresql+psycopg://pharma:pharma@timescaledb:5432/pharma_timeseries
ELASTICSEARCH_URL=http://elasticsearch:9200
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_TOKEN=
