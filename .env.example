APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# 本机运行 .venv\Scripts\datactl.exe 时使用；默认 SQLite，无需启动 PostgreSQL。
DATABASE_URL=sqlite:///./data/runtime/pharma.db
OBJECT_STORE_ROOT=./data/objects
PUBLIC_EXPORT_ROOT=./data/exports
# Docker 服务使用的内部地址。Compose 会用这些值覆盖上面的本机地址。
CONTAINER_DATABASE_URL=postgresql+psycopg://pharma:pharma@postgres:5432/pharma
CONTAINER_OBJECT_STORE_ROOT=/app/data/objects
CONTAINER_PUBLIC_EXPORT_ROOT=/app/data/exports
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=2
WORKER_LOCK_SECONDS=900
INBOX_ENABLED=true
# 目录即权限：公开文件放 public，受限文件放 restricted。
PUBLIC_INBOX_ROOT=./data/public
PUBLIC_INBOX_ARCHIVE_ROOT=./data/public/_archive
PUBLIC_INBOX_METADATA_ROOT=./data/public/_metadata
PUBLIC_INBOX_QUARANTINE_ROOT=./data/public/_quarantine
RESTRICTED_INBOX_ROOT=./data/restricted
RESTRICTED_INBOX_ARCHIVE_ROOT=./data/restricted/_archive
RESTRICTED_INBOX_METADATA_ROOT=./data/restricted/_metadata
RESTRICTED_INBOX_QUARANTINE_ROOT=./data/restricted/_quarantine
INBOX_ARCHIVE_MODE=move
INBOX_POLL_SECONDS=10
INBOX_SETTLE_SECONDS=5
AUTHORITATIVE_SOURCE_CATALOG_PATH=./config/authoritative_sources.json
# 质量优先 PDF：应用通过独立 MinerU 服务解析，应用 API 仍使用 8000。
MINERU_ENABLED=true
MINERU_REQUIRED=false
MINERU_EXECUTION_MODE=local
MINERU_API_URL=http://127.0.0.1:18010
# 可选：同一 pipeline 的 CPU 服务；仅 CUDA OOM 时使用并记录降级原因。
MINERU_CPU_API_URL=
MINERU_BACKEND=pipeline
MINERU_SERVER_URL=
MINERU_DEVICE=cuda
MINERU_MAX_CONCURRENCY=1
MINERU_VIRTUAL_VRAM_SIZE=3
MINERU_PAGE_BATCH_SIZE=1
MINERU_TIMEOUT_SECONDS=7200
MINERU_NODE_ID=local-gpu-0
MINERU_TRUSTED_HOSTS=127.0.0.1,localhost
MINERU_ALLOWED_ACCESS_CLASSES=public,restricted
MINERU_RAW_OUTPUT_ROOT=./data/parser_outputs/mineru
MINERU_RETURN_IMAGES=true
MINERU_MAX_IMAGE_BYTES=26214400
MINERU_CPU_FALLBACK=true
VISUAL_SEMANTICS_ENABLED=true
VISUAL_SEMANTICS_REQUIRED=true
VISUAL_SEMANTICS_MIN_CONFIDENCE=0.85
PP_STRUCTURE_FALLBACK=true
PP_STRUCTURE_FALLBACK=true
# 远程私有 GPU 的 bearer token，只通过环境变量提供，不写入数据库。
MINERU_API_KEY=
INTERNAL_API_KEY=replace-with-a-long-random-secret
# 中国大陆官方来源多数无需密钥；需要账号、授权或人工导出的来源按清单接入。
# 此邮箱只用于项目来源登记和问题联系，不会自动发送给第三方。
PROJECT_CONTACT_EMAIL=
HTTP_USER_AGENT=pharma-analyst-data/0.2
HTTP_RATE_LIMIT_PER_SECOND=1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
MILVUS_URI=http://localhost:19530
TIMESCALE_URL=postgresql+psycopg://pharma:pharma@localhost:5433/pharma_timeseries
ELASTICSEARCH_URL=http://localhost:9200
CONTAINER_NEO4J_URI=bolt://neo4j:7687
CONTAINER_MILVUS_URI=http://milvus:19530
CONTAINER_TIMESCALE_URL=postgresql+psycopg://pharma:pharma@timescaledb:5432/pharma_timeseries
CONTAINER_ELASTICSEARCH_URL=http://elasticsearch:9200
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_TOKEN=
