{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pharma-agent/schemas/assertion.schema.json",
  "title": "AssertionCandidate",
  "type": "object",
  "required": ["assertion_id", "subject_mention_id", "predicate", "assertion_mode", "evidence_text", "extraction_method", "confidence", "review_status"],
  "properties": {
    "assertion_id": {"type": "string"},
    "subject_mention_id": {"type": "string"},
    "predicate": {"type": "string"},
    "object_mention_id": {"type": ["string", "null"]},
    "object_value": {"type": ["string", "null"]},
    "object_unit": {"type": ["string", "null"]},
    "qualifiers": {"type": "object"},
    "assertion_mode": {"enum": ["stated", "derived", "calculated", "human_entered"]},
    "evidence_element_id": {"type": ["string", "null"]},
    "evidence_utterance_id": {"type": ["string", "null"]},
    "evidence_text": {"type": "string", "minLength": 1},
    "extraction_method": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["candidate", "pending", "approved", "rejected"]}
  }
}
